---
layout: base.njk
title: blog
permalink: /blog/
eleventyExcludeFromCollections: true
---
<h1 data-typed>blog</h1>
<p class="lede">Notes, experiments, and things I figured out along the way.</p>
{%- set lastYear = 0 %}
{% for post in collections.post | reverse %}
{%- set y = post.date | year %}
{%- if y != lastYear %}{% if lastYear %}</ol>{% endif %}
<h2 class="year-head">{{ y }}</h2>
<ol class="post-cards">{% set lastYear = y %}{% endif %}
  <li>
    <span class="date">{{ post.date | dayMonth }}</span>
    <div>
      <a class="post-title" href="{{ post.url }}">{{ post.data.title }}</a>
      <p class="excerpt">{{ post.content | excerpt }}</p>
      <p class="post-meta">{% if post.data.topic %}<span class="topic">{{ post.data.topic }}</span> · {% endif %}{{ post.content | readTime }} min read</p>
    </div>
  </li>
{%- endfor %}
</ol>
