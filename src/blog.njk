---
layout: base.njk
title: blog
permalink: /blog/
eleventyExcludeFromCollections: true
extraJs: /js/blog.js
---
{%- set posts = collections.post | reverse %}
{#- signed in as Dana (src/js/blog-author.js): this bar, the drafts box and the edit links are filled in after
    the site API says so, so none of it is ever in the published HTML #}
<p class="blog-bar" data-blog-bar data-api="{{ siteApi }}" hidden></p>
<h1 data-typed>blog</h1>
<p class="lede">Notes, experiments, and things I figured out along the way.</p>
{#- topic filter (src/js/blog.js); hidden without JavaScript, when every post is simply listed #}
<nav class="tag-filter" aria-label="Filter notes by topic" hidden>
  <p class="tf-prompt" aria-hidden="true"><span class="d">~/dana $</span> ls blog/ <span class="flag">--topic</span> <span class="arg" data-arg>*</span></p>
  <div class="tf-tags">
    <button type="button" class="tf-tag" data-tag="" aria-pressed="true">all<span class="n">{{ posts.length }}</span></button>
    {%- for t in posts | topicCounts %}
    <button type="button" class="tf-tag" data-tag="{{ t.name }}" aria-pressed="false">{{ t.name }}<span class="n">{{ t.count }}</span></button>
    {%- endfor %}
  </div>
  <p class="visually-hidden" aria-live="polite" data-tf-live></p>
</nav>
<section class="blog-drafts" data-drafts aria-label="Your drafts" hidden>
  <h2 class="drafts-head">drafts <span>· only you can see these</span></h2>
  <ol class="post-cards draft-cards" data-draft-list></ol>
</section>
{%- set lastYear = 0 %}
{% for post in posts %}
{%- set y = post.date | year %}
{%- if y != lastYear %}{% if lastYear %}</ol>{% endif %}
<h2 class="year-head">{{ y }}</h2>
<ol class="post-cards">{% set lastYear = y %}{% endif %}
  {%- set ts = post.data | topics %}
  <li data-topics="{{ ts | join('|') }}" data-slug="{{ post.page.fileSlug }}">
    <span class="date">{{ post.date | dayMonth }}</span>
    <div>
      <a class="post-title" href="{{ post.url }}">{{ post.data.title }}</a>
      <p class="excerpt">{{ post.content | excerpt }}</p>
      <p class="post-meta">{% for t in ts %}<a class="topic" href="/blog/?tag={{ t | tagSlug }}" data-tag="{{ t }}">{{ t }}</a> {% endfor %}{% if ts.length %}· {% endif %}{{ post.content | readTime }} min read</p>
    </div>
  </li>
{%- endfor %}
</ol>
<p class="blog-signin" data-blog-signin>{% if siteApi %}<button type="button" class="linkish" data-signin-open>sign in</button>{% endif %}</p>
<script src="/js/blog-author.js?v={{ build.v }}" defer></script>
