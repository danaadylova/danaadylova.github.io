---
layout: base.njk
title: home
eleventyExcludeFromCollections: true
---
{%- set posts = collections.post | reverse -%}
{%- set live = [] -%}{%- for p in collections.project -%}{%- if p.data.status == "live" -%}{%- set live = (live.push(p), live) -%}{%- endif -%}{%- endfor -%}
<p class="intro">Hi, I'm Dana — developer and crafter in the Bay Area. I like building small, useful things, usually related to <em>code</em> and <em>yarn</em>.</p>

<div class="kb" data-kb data-case="cream" aria-hidden="true"></div>
<p class="typed-line"><span id="typed" data-typed data-text="~/dana $ ls -l">~/dana $ ls -l</span></p>
<ul class="ls-long" aria-label="What's on this site">
  <li><a href="/blog/">blog/</a><span class="what">notes on knitting, books and code</span><span class="info">{{ posts.length }} posts · latest {{ posts[0].date | dayMonth }}</span></li>
  <li><a href="/projects/">projects/</a><span class="what">things I make</span><span class="info">{{ live.length }} live</span></li>
  <li><a href="/books/">books/</a><span class="what">everything I've read, on a shelf</span><span class="info">{{ books.total }} books{% if books.reading.length %} · reading <i>{{ books.reading[0].title }}</i>{% endif %}</span></li>
  <li><a href="/now/">now/</a><span class="what">what I'm up to these days</span><span class="info">{{ now_updated }}</span></li>
  <li><a href="/resume/">resume/</a><span class="what">the work history</span><span class="info">one page, printable</span></li>
</ul>

<h2>recent notes</h2>
<ul class="post-list">
{% for post in posts %}{% if loop.index <= 3 %}
  <li><span class="date">{{ post.date | gdate }}</span> <a href="{{ post.url }}">{{ post.data.title }}</a>{% if post.data.topic %}<span class="topic">{{ post.data.topic }}</span>{% endif %}</li>
{% endif %}{% endfor %}
</ul>
<p class="more-link"><a class="wikilink" href="/blog/">all notes →</a></p>

<script src="/js/vendor/three.r128.min.js" defer></script>
<script src="/js/keyboard.js?v={{ build.v }}" defer></script>
